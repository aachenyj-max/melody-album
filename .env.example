NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Server-only key. Paste the project's secret key here manually; never expose it with NEXT_PUBLIC_.
SECRET_KEY=replace-with-your-supabase-secret-key
# Server-only random secret (at least 32 characters) for a per-browser demo scope
# when Supabase anonymous sign-in is disabled. Never use NEXT_PUBLIC_ here.
DEMO_SESSION_SECRET=replace-with-a-random-32-character-or-longer-secret
# Server-only Vercel Cron bearer secret (at least 32 bytes) for expired album uploads.
CRON_SECRET=

# Server-only fal.ai key for ACE-Step Prompt to Audio. Never expose with NEXT_PUBLIC_.
FAL_KEY=replace-with-your-fal-key
# Optional server-only proxy when this computer cannot reach fal.ai directly.
# FAL_PROXY_URL=http://127.0.0.1:7897
# Development-only demo adapter scenarios when FAL_KEY is absent: slow or error.
# FAL_DEMO_SCENARIO=slow

# Internal Agent workbench. Empty credentials keep human pages/APIs closed.
# Set these only on the server; the session secret must contain at least 32 bytes.
WORKBENCH_ACCESS_PASSWORD=
WORKBENCH_SESSION_SECRET=
WORKBENCH_PUBLIC_ORIGIN=http://localhost:3000
# Independent machine credential, at least 32 bytes; used only for retention cleanup.
WORKBENCH_MAINTENANCE_TOKEN=
# Optional server-only database transport proxy; never sent to the browser.
WORKBENCH_SUPABASE_PROXY_URL=
# Explicit opt-in to paid providers. Both modes default to demo even if keys exist.
PI_EXECUTION_MODE=demo
WORKBENCH_MUSIC_MODE=demo
# User entry and workbench share the Pi runtime. This mode is an independent paid opt-in.
# If omitted, USER_AGENT_MODE follows explicit PI_EXECUTION_MODE; never inferred from a key.
USER_AGENT_MODE=demo
# Pin the tested workbench configuration version. 0 = code-owned baseline.
# New workbench drafts do not change this. Change the number and redeploy after verification.
USER_AGENT_CONFIG_VERSION=0
# Live requires a vision + tool-capable model and matching protocol/provider/key.
# PI_LLM_API: openai-completions | openai-responses | anthropic-messages
PI_LLM_PROVIDER=
PI_LLM_MODEL=
PI_LLM_API=
PI_LLM_BASE_URL=
PI_LLM_API_KEY=
# Alibaba Beijing workspace (key stays empty until manually provided):
# PI_LLM_PROVIDER=alibaba
# PI_LLM_MODEL=qwen3-vl-flash
# PI_LLM_API=openai-completions
# PI_LLM_BASE_URL=https://llm-a5ntatubdh5b5n88.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
